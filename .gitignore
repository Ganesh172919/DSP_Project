# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# Pylance / Pyright / Python language server caches
.pyright/
.pylance/
pyrightconfig.cache

# Environment and local secrets
.env
.env.*
!.env.example
*.local

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Python virtual environments
venv/
.venv/
env/
.env/
backend/venv/

# Node dependencies and frontend build output
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# Runtime databases and generated indexes
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.index
backend/data/face.index
backend/data/tmp_*.mp4
backend/data/tmp_*.webm

# Large model and training artifacts
backend/weights/
*.onnx
*.pth
*.pt
*.ckpt
*.safetensors
*.pkl
*.joblib

# Training datasets and generated reports
backend/data/liveness/
backend/data/deepfake/
backend/data/test/
backend/data/faces/
backend/data/calibration/
reports/
artifacts/
runs/
checkpoints/

# Private keys and certificates
backend/keys/*.pem
*.key
*.crt
*.csr

# Keep required project manifests tracked
!backend/requirements.txt
!backend/Dockerfile
!frontend/package.json
!frontend/package-lock.json
!frontend/vite.config.js
